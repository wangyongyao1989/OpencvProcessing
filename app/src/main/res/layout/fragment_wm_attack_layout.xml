<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- 顶部：返回 + 标题 -->
        <!-- Top bar: back + title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_back"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/common_back"
                android:textAllCaps="false" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/wm_attack_title"
                android:textColor="#111111"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 攻击方式选择（单选） -->
        <!-- Attack type selection (single choice) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/wm_attack_select_hint"
            android:textColor="#111111"
            android:textSize="16sp"
            android:textStyle="bold" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:columnCount="3"
            android:alignmentMode="alignMargins">

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cb_atk_jpeg"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:text="@string/wm_atk_jpeg"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#111111" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cb_atk_gaussian"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:text="@string/wm_atk_gaussian"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#111111" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cb_atk_salt"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:text="@string/wm_atk_salt"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#111111" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cb_atk_mean"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:text="@string/wm_atk_mean"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#111111" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cb_atk_median"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:text="@string/wm_atk_median"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#111111" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cb_atk_scale"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:text="@string/wm_atk_scale"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#111111" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cb_atk_rotate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:text="@string/wm_atk_rotate"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#111111" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cb_atk_crop"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:text="@string/wm_atk_crop"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#111111" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cb_atk_drop"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:text="@string/wm_atk_drop"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#111111" />
        </GridLayout>

        <!-- 执行按钮 -->
        <!-- Run button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_attack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/wm_btn_attack"
            android:textAllCaps="false" />

        <!-- 进度 -->
        <!-- Progress -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:max="100"
            app:trackCornerRadius="4dp" />

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#111111" />

        <!-- 攻击结果：帧对比 -->
        <!-- Attack result: frame comparison -->
        <TextView
            android:id="@+id/tv_result_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/wm_attack_result_title"
            android:textColor="#111111"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/layout_frame_compare"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/wm_watermarked_frame"
                    android:textColor="#333333"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/iv_frame_before"
                    android:layout_width="match_parent"
                    android:layout_height="110dp"
                    android:layout_marginTop="4dp"
                    android:contentDescription="@string/wm_watermarked_frame_desc"
                    android:scaleType="fitCenter"
                    android:background="#DDDDDD" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/wm_attacked_frame"
                    android:textColor="#333333"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/iv_frame_after"
                    android:layout_width="match_parent"
                    android:layout_height="110dp"
                    android:layout_marginTop="4dp"
                    android:contentDescription="@string/wm_attacked_frame_desc"
                    android:scaleType="fitCenter"
                    android:background="#DDDDDD" />
            </LinearLayout>
        </LinearLayout>

        <!-- 提取的水印 + 指标 -->
        <!-- Extracted watermark + metrics -->
        <LinearLayout
            android:id="@+id/layout_extract_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:id="@+id/iv_watermark_extracted"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:contentDescription="@string/wm_watermark_extracted_desc"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/tv_metrics"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_gravity="center_vertical"
                android:layout_weight="1"
                android:textColor="#1B5E20"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 对策说明 -->
        <!-- Countermeasure explanation -->
        <TextView
            android:id="@+id/tv_countermeasure_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/wm_countermeasure_title"
            android:textColor="#111111"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_countermeasure"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_countermeasure"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#111111" />
        </com.google.android.material.card.MaterialCardView>

        <!-- 原理及公式 -->
        <!-- Principle & formula -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/common_principle_formula"
            android:textColor="#111111"
            android:textSize="16sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp">

            <TextView
                android:id="@+id/tv_formula"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"

                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#111111" />
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
