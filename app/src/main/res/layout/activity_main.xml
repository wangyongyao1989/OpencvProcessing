<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="灰度变换 - 数字图像与视频处理 2.2节"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_opencv_version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:textSize="13sp" />

        <!-- 原始图像 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="① 原始图像"
            android:textStyle="bold"
            android:layout_marginTop="4dp" />

        <ImageView
            android:id="@+id/iv_original"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:layout_marginBottom="8dp" />

        <!-- 灰度线性变换 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="② 灰度线性变换 [50,200]→[0,255] (式2-1)"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/iv_linear"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:layout_marginBottom="8dp" />

        <!-- 反转变换 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="③ 反转变换 (图2-3)"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/iv_invert"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:layout_marginBottom="8dp" />

        <!-- 对比度扩展 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="④ 对比度扩展/分段线性 a=80,b=180,c=30,d=220 (式2-3)"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/iv_piecewise"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:layout_marginBottom="8dp" />

        <!-- 削波 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⑤ 削波 [100,180] (图2-6)"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/iv_clip"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:layout_marginBottom="8dp" />

        <!-- 阈值化 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⑥ 阈值化 T=128 (图2-7)"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/iv_threshold"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:layout_marginBottom="8dp" />

        <!-- 对数变换 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⑦ 对数变换 (式2-4)"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/iv_log"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:layout_marginBottom="8dp" />

        <!-- 伽马变换 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⑧ 伽马变换 γ=0.5 (式2-5)"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/iv_gamma"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:layout_marginBottom="8dp" />

        <!-- 直方图均衡化 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⑨ 直方图均衡化 (式2-14)"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/iv_histeq"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:layout_marginBottom="16dp" />

    </LinearLayout>
</ScrollView>
